# ─── CodifyAI Backend — Environment Variables ───────────────────────────────
# Copy to .env and fill in values. NEVER commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://codifyai:changeme@localhost:5432/codifyai
TEST_DATABASE_URL=postgresql+asyncpg://codifyai:changeme@localhost:5432/codifyai_test

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning depth: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# ── CPT® ──────────────────────────────────────────────────────────────────────
# CPT codes and descriptors are licensed AMA content. Leave false until the AMA
# license is signed: no CPT codes/descriptors are returned and E/M is a level only.
CPT_LICENSED=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=replace-with-64-char-hex-string
REFRESH_SECRET_KEY=replace-with-different-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1
# Absolute session lifetime — refreshing can't extend a login past this
MAX_SESSION_HOURS=12

# ── Encryption at rest (MFA secrets, note HMAC key) ──────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it invalidates every enrolled MFA secret.
ENCRYPTION_KEY=replace-with-fernet-key

# ── MFA ───────────────────────────────────────────────────────────────────────
# true = every user must enroll in TOTP MFA before using the app (recommended in production)
REQUIRE_MFA=false

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ENFORCE_HTTPS=false
# Production refuses to start unless ENFORCE_HTTPS=true, DATABASE_SSL=true and
# ALLOWED_ORIGINS has no localhost entries.

# ── Database TLS ──────────────────────────────────────────────────────────────
DATABASE_SSL=false

# ── Reverse proxies ───────────────────────────────────────────────────────────
# IPs/CIDRs of proxies (nginx, Azure Front Door, App Gateway) whose
# X-Forwarded-For / X-Forwarded-Proto headers are trusted. Empty = trust none.
# e.g. TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ANALYZE_PER_MINUTE=10
# memory:// is per-process; use redis://host:6379 when running multiple workers
RATE_LIMIT_STORAGE_URI=memory://

# ── Azure (production) ────────────────────────────────────────────────────────
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=

# ─── CodifyAI Backend — Environment Variables ───────────────────────────────
# Copy to .env and fill in values. NEVER commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://codifyai:changeme@localhost:5432/codifyai
TEST_DATABASE_URL=postgresql+asyncpg://codifyai:changeme@localhost:5432/codifyai_test

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=replace-with-64-char-hex-string
REFRESH_SECRET_KEY=replace-with-different-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ENFORCE_HTTPS=false

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_ANALYZE_PER_MINUTE=10

# ── Azure (production) ────────────────────────────────────────────────────────
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=

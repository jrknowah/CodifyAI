# Production nginx config (rendered at container start).
# BACKEND_FQDN is the API's internal Container Apps hostname, set by infra/main.bicep.
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;

    client_max_body_size 10m;
    server_tokens off;

    # React SPA — all routes fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy /api to FastAPI over TLS inside the VNet
    location /api {
        proxy_pass https://${BACKEND_FQDN};
        proxy_ssl_server_name on;
        proxy_ssl_name ${BACKEND_FQDN};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host ${BACKEND_FQDN};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header Cache-Control "no-store" always;
}
